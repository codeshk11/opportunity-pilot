{
  "name": "opppilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:lan": "vite dev --host --port 3000",
    "build": "vite build && tsc",
    "start": "node .output/server/index.mjs",
    "serve": "vite preview",
    "preview": "vite build && tsc && vite preview --port 4173",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit --pretty",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,css}\" --cache",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@shadcn/lint": "^0.2.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "jsdom": "^20.0.3",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "typescript": "^5.8.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
