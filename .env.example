# Supabase project: Project Settings -> API. The publishable key is safe to
# ship to the browser; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Bypasses row-level security; never prefix it with VITE_.
# Only needed for trusted admin work such as the future listings agent.
# SUPABASE_SERVICE_ROLE_KEY=
